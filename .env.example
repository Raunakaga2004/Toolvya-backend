DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:4200

# Use PostgreSQL for local development by setting:
# DATABASE_ENGINE=django.db.backends.postgresql
DATABASE_ENGINE=django.db.backends.sqlite3
DATABASE_NAME=toolvaya
DATABASE_USER=toolvaya
DATABASE_PASSWORD=toolvaya
DATABASE_HOST=127.0.0.1
DATABASE_PORT=5432

CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/0
CELERY_TASK_ALWAYS_EAGER=true

PDF_MAX_INPUT_FILES=10
PDF_MAX_INPUT_BYTES=52428800
PDF_MAX_PAGES=500
PDF_JOB_TTL_HOURS=24
PDF_CLEANUP_BATCH_SIZE=100
